# Modo de datos:
#   mock   → base local en localStorage (sin backend)
#   hybrid → backend para lo que ya implementa (auth, talles, perfiles,
#            direcciones, catálogo admin) y mock para el resto
#   http   → todo contra el backend
VITE_API_MODE=mock

# Solo en modo hybrid/http: el dev server reenvía `VITE_API_BASE_URL` al backend.
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:8080

# Solo en modo mock
VITE_MOCK_LATENCY_MS=250-600
VITE_MOCK_FAIL_RATE=0
